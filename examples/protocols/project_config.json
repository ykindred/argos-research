{
  "research_context": "Study runtime on a fixed benchmark.",
  "main_research_question": "Can runtime be reduced without changing outputs?",
  "source_repository": "/research/example",
  "build_command": [
    "python",
    "-m",
    "build"
  ],
  "test_command": [
    "python",
    "-m",
    "pytest"
  ],
  "evaluation_protocol": {
    "name": "fixed-benchmark-v1",
    "command": [
      "python",
      "evaluate.py"
    ],
    "metric_names": [
      "latency_ms"
    ],
    "constraints": [
      "latency_ms <= 10"
    ]
  },
  "scope": {
    "editable_paths": [
      "src/**",
      "tests/**"
    ],
    "protected_paths": [
      "evaluate.py",
      "data/**",
      "baseline/**"
    ]
  },
  "resource_limits": {
    "timeout_seconds": 120,
    "max_memory_mb": 1024,
    "max_cpu_cores": 1
  },
  "research_charter": "# Research Charter\nReduce runtime while preserving outputs; human owns direction.",
  "research_direction": "Computational efficiency",
  "held_out_test_protocol": "Fixed held-out inputs v1; no tuning on these inputs.",
  "resources": {
    "llm_slots": 4,
    "coding_slots": 1,
    "cpu_jobs": 1,
    "gpu_jobs": 1
  },
  "limits": {
    "max_cycles": 30,
    "max_experiments": 50,
    "stagnation_cycles": 5
  }
}
